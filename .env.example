# Postgres. Vazio = PGLite (embutido, bom para dev).
DATABASE_URL=

# Dados de demonstracao em empresa nova. Vazio = so no PGLite; com Postgres
# a empresa comeca vazia. 1 liga, 0 desliga.
GC_DEMO_SEED=

# SaaS multi-empresa: 1 libera qualquer um criar conta E empresa nova (ligar
# so no projeto Vercel, nunca numa instalacao on-premise -- loja unica quer
# cadastro fechado, so convite). VITE_MULTI_TENANT=true junto mostra o link
# de cadastro na tela de login.
GC_MULTI_TENANT=
VITE_MULTI_TENANT=

# true em produção. O wrapper npm mescla .grok/app-env.json.
VITE_AUTH_ENABLED=true

# Better Auth (e-mail/senha). Gere um secret longo fora do sandbox.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080
