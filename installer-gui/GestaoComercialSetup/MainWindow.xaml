<Window x:Class="GestaoComercialSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestaoComercialSetup"
        mc:Ignorable="d"
        Title="Gestao Comercial - Instalacao"
        Height="640" Width="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Border Background="{StaticResource CorFundo}" CornerRadius="18" BorderBrush="{StaticResource CorBorda}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Cabecalho arrastavel, sempre visivel -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Cabecalho_MouseLeftButtonDown" Margin="24,18,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00D9FF" Offset="0"/>
                                <GradientStop Color="#00A8CC" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="G" FontWeight="Bold" Foreground="#0F0F1E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Gestao Comercial - Instalacao" FontFamily="{StaticResource FontePrincipal}" FontSize="13" Foreground="{StaticResource CorTextoSecundario}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="30" Height="30" Style="{StaticResource BotaoSecundario}"
                        Click="Fechar_Click" VerticalAlignment="Top" Padding="0"/>
            </Grid>

            <!-- ============ TELA 1: BOAS-VINDAS ============ -->
            <Grid x:Name="TelaBoasVindas" Grid.Row="1" Margin="40,10,40,32">
                <StackPanel VerticalAlignment="Center">

                    <Grid HorizontalAlignment="Center" Margin="0,0,0,22" Width="140" Height="110">
                        <Ellipse Width="140" Height="140" Opacity="0.12" VerticalAlignment="Top">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#00D9FF" Offset="0"/>
                                    <GradientStop Color="#0F0F1E" Offset="0.75"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Border Width="76" Height="76" CornerRadius="22" VerticalAlignment="Top">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="16" ShadowDepth="4"/>
                            </Border.Effect>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3CE9FF" Offset="0"/>
                                    <GradientStop Color="#0098C2" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <TextBlock Text="G" FontSize="32" FontWeight="Bold" Foreground="#0F0F1E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border CornerRadius="22,22,60,60" VerticalAlignment="Top" Height="34" Opacity="0.22">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="White" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock Text="Gestao Comercial" Style="{StaticResource Titulo}" FontSize="25" HorizontalAlignment="Center"/>
                    <TextBlock Text="Vamos deixar o sistema pronto pra usar nesta maquina." Style="{StaticResource Subtitulo}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,28" MaxWidth="360"/>

                    <Border Background="{StaticResource CorCard}" CornerRadius="16" Padding="20,18" BorderBrush="{StaticResource CorBorda}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="24" ShadowDepth="6"/>
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="#2600D9FF" VerticalAlignment="Top" Margin="0,0,12,0">
                                    <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Foreground="{StaticResource CorAcento}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Cria o banco de dados e gera as credenciais sozinho, sem pedir senha pra ninguem" Style="{StaticResource Subtitulo}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="#2600D9FF" VerticalAlignment="Top" Margin="0,0,12,0">
                                    <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Foreground="{StaticResource CorAcento}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Configura o firewall pra so aceitar acesso da rede da loja" Style="{StaticResource Subtitulo}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="#2600D9FF" VerticalAlignment="Top" Margin="0,0,12,0">
                                    <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Foreground="{StaticResource CorAcento}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Coloca o sistema no ar como um servico do Windows" Style="{StaticResource Subtitulo}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BotaoInstalar" Content="Instalar" Style="{StaticResource BotaoPrimario}"
                            FontSize="15" Padding="16,14" Margin="0,28,0,0" Click="BotaoInstalar_Click"/>
                </StackPanel>
            </Grid>

            <!-- ============ TELA 2: PROGRESSO ============ -->
            <Grid x:Name="TelaProgresso" Grid.Row="1" Margin="32,20,32,24" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Instalando" Style="{StaticResource Titulo}" Margin="0,20,0,4"/>
                <TextBlock x:Name="TextoEtapaAtual" Grid.Row="1" Text="Iniciando..." Style="{StaticResource Subtitulo}" Margin="0,0,0,18"/>

                <!-- Barra "varredura de luz": um retangulo com gradiente transparente-ciano-transparente
                     desliza da esquerda pra direita em loop. O ProgressBar padrao do WPF so anima
                     IsIndeterminate de verdade com o template/chrome original, que perdemos ao
                     customizar; aqui a animacao e explicita (Storyboard), entao sempre roda. -->
                <Border Grid.Row="2" Height="8" CornerRadius="4" Background="{StaticResource CorCard}" ClipToBounds="True" Margin="0,0,0,18">
                    <Rectangle x:Name="IndicadorProgresso" Width="160" Height="8" RadiusX="4" RadiusY="4" HorizontalAlignment="Left">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#00D9FF" Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="TransformIndicador" X="-160"/>
                        </Rectangle.RenderTransform>
                        <Rectangle.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TransformIndicador" Storyboard.TargetProperty="X"
                                                         From="-160" To="516" Duration="0:0:1.3" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Rectangle.Triggers>
                    </Rectangle>
                </Border>

                <!-- Paineis condicionais (so aparecem quando o script pede via sentinela) -->
                <StackPanel Grid.Row="3">
                    <Border x:Name="PainelSenha" Background="{StaticResource CorCard}" CornerRadius="12" Padding="16" Margin="0,0,0,12" Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="18" ShadowDepth="4"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Senha de superusuario do PostgreSQL" Style="{StaticResource Rotulo}"/>
                            <TextBlock Text="Este PostgreSQL ja estava instalado nesta maquina antes deste instalador -- precisamos da senha do usuario 'postgres' dele pra criar o banco deste app, sem mexer em outros bancos existentes." Style="{StaticResource Subtitulo}" Margin="0,0,0,10"/>
                            <PasswordBox x:Name="CampoSenhaPostgres" Style="{StaticResource CampoTexto}" KeyDown="CampoSenhaPostgres_KeyDown"/>
                            <Button Content="Confirmar senha" Style="{StaticResource BotaoPrimario}" Margin="0,10,0,0" HorizontalAlignment="Right" Click="BotaoConfirmarSenha_Click"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="PainelRede" Background="{StaticResource CorCard}" CornerRadius="12" Padding="16" Margin="0,0,0,12" Visibility="Collapsed" BorderBrush="{StaticResource CorAviso}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="18" ShadowDepth="4"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Rede marcada como &quot;Publica&quot; no Windows" Style="{StaticResource Rotulo}" Foreground="{StaticResource CorAviso}"/>
                            <TextBlock Text="Isso normalmente esta errado pra rede interna de uma loja. Confirma que quer continuar mesmo assim?" Style="{StaticResource Subtitulo}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Nao, cancelar" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0" Click="BotaoRedeNao_Click"/>
                                <Button Content="Sim, continuar" Style="{StaticResource BotaoPrimario}" Click="BotaoRedeSim_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Preenche o espaco enquanto roda: um badge pulsando por padrao, trocado pelo
                     log cru quando "Ver detalhes" e clicado. Sem isso a tela ficava com uma
                     area vazia enorme abaixo da barra de progresso. -->
                <DockPanel Grid.Row="4" LastChildFill="True">
                    <Button x:Name="BotaoDetalhes" DockPanel.Dock="Top" Content="Ver detalhes ▾" Style="{StaticResource BotaoLink}"
                            FontSize="12" Margin="0,4,0,0" Click="BotaoDetalhes_Click"/>
                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Border x:Name="PainelPulso" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="32">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="14" ShadowDepth="3"/>
                                </Border.Effect>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#3CE9FF" Offset="0"/>
                                        <GradientStop Color="#0098C2" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="G" FontSize="26" FontWeight="Bold" Foreground="#0F0F1E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="EscalaPulso" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="EscalaPulso" Storyboard.TargetProperty="ScaleX"
                                                                 From="1" To="1.12" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever"/>
                                                <DoubleAnimation Storyboard.TargetName="EscalaPulso" Storyboard.TargetProperty="ScaleY"
                                                                 From="1" To="1.12" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </Border>
                        <TextBox x:Name="CaixaLog" Style="{StaticResource CampoCodigo}" Visibility="Collapsed"/>
                    </Grid>
                </DockPanel>
            </Grid>

            <!-- ============ TELA 3: CONCLUSAO ============ -->
            <Grid x:Name="TelaFinal" Grid.Row="1" Margin="40,20,40,32" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <Border x:Name="BadgeFinal" Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <TextBlock x:Name="IconeFinal" Text="✓" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TituloFinal" Text="Instalacao concluida" Style="{StaticResource Titulo}" FontSize="22" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock x:Name="TextoFinal" Style="{StaticResource Subtitulo}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,28" MaxWidth="380"/>

                    <Button x:Name="BotaoAcaoFinal" Content="Abrir o sistema" Style="{StaticResource BotaoPrimario}"
                            FontSize="15" Padding="16,14" HorizontalAlignment="Stretch" Click="BotaoAcaoFinal_Click"/>
                    <Button x:Name="BotaoVerLog" Content="Ver detalhes" Style="{StaticResource BotaoLink}"
                            HorizontalAlignment="Center" Margin="0,14,0,0" Click="BotaoVerLogFinal_Click"/>

                    <TextBox x:Name="CaixaLogFinal" Style="{StaticResource CampoCodigo}" Height="180" Margin="0,20,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>
