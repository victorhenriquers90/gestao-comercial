<Window x:Class="GestaoComercialSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestaoComercialSetup"
        mc:Ignorable="d"
        Title="Gestao Comercial - Instalacao"
        Height="620" Width="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Border Background="{StaticResource CorFundo}" CornerRadius="18" BorderBrush="{StaticResource CorBorda}" BorderThickness="1">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Cabecalho arrastavel -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Cabecalho_MouseLeftButtonDown" Margin="24,20,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Gestao Comercial" Style="{StaticResource Titulo}"/>
                    <TextBlock Text="Instalacao / atualizacao do sistema nesta maquina" Style="{StaticResource Subtitulo}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="32" Height="32" Style="{StaticResource BotaoSecundario}"
                        Click="Fechar_Click" VerticalAlignment="Top"/>
            </Grid>

            <!-- Conteudo -->
            <StackPanel Grid.Row="1" Margin="24,8,24,20">

                <!-- Senha do Postgres (so aparece quando o script pede via sentinela) -->
                <Border x:Name="PainelSenha" Background="{StaticResource CorCard}" CornerRadius="12" Padding="16" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Senha de superusuario do PostgreSQL" Style="{StaticResource Rotulo}"/>
                        <TextBlock Text="Este PostgreSQL ja estava instalado nesta maquina antes deste instalador -- precisamos da senha do usuario 'postgres' dele pra criar o banco deste app, sem mexer em outros bancos existentes." Style="{StaticResource Subtitulo}" Margin="0,0,0,10"/>
                        <PasswordBox x:Name="CampoSenhaPostgres" Style="{StaticResource CampoTexto}" KeyDown="CampoSenhaPostgres_KeyDown"/>
                        <Button x:Name="BotaoConfirmarSenha" Content="Confirmar senha" Style="{StaticResource BotaoPrimario}" Margin="0,10,0,0" HorizontalAlignment="Right" Click="BotaoConfirmarSenha_Click"/>
                    </StackPanel>
                </Border>

                <!-- Aviso de rede publica (so aparece quando o script pede via sentinela) -->
                <Border x:Name="PainelRede" Background="{StaticResource CorCard}" CornerRadius="12" Padding="16" Margin="0,0,0,12" Visibility="Collapsed" BorderBrush="{StaticResource CorAviso}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Rede marcada como &quot;Publica&quot; no Windows" Style="{StaticResource Rotulo}" Foreground="{StaticResource CorAviso}"/>
                        <TextBlock Text="Isso normalmente esta errado pra rede interna de uma loja. Confirma que quer continuar mesmo assim?" Style="{StaticResource Subtitulo}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Nao, cancelar" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0" Click="BotaoRedeNao_Click"/>
                            <Button Content="Sim, continuar" Style="{StaticResource BotaoPrimario}" Click="BotaoRedeSim_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Acao principal -->
                <Button x:Name="BotaoInstalar" Content="Instalar" Style="{StaticResource BotaoPrimario}"
                        FontSize="15" Padding="16,14" Click="BotaoInstalar_Click"/>

                <!-- Log ao vivo -->
                <TextBlock Text="Log da instalacao" Style="{StaticResource Rotulo}" Margin="0,16,0,0"/>
                <TextBox x:Name="CaixaLog" Style="{StaticResource CampoCodigo}" Height="280" Margin="0,4,0,0"/>

                <!-- Rodape de status -->
                <Border x:Name="PainelStatusFinal" CornerRadius="10" Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="TextoStatusFinal" Style="{StaticResource Rotulo}" TextWrapping="Wrap"/>
                </Border>

            </StackPanel>
        </Grid>
    </Border>
</Window>
