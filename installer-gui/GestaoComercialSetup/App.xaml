<Application x:Class="GestaoComercialSetup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GestaoComercialSetup"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Paleta escura, mesma linguagem visual do produto irmao "PDV novo"
                 (Pdv.Caixa\App.xaml), recriada aqui do zero - projetos separados,
                 sem dicionario de recursos compartilhado entre repos. -->
            <SolidColorBrush x:Key="CorFundo" Color="#0F0F1E"/>
            <SolidColorBrush x:Key="CorPainel" Color="#1A1A2E"/>
            <SolidColorBrush x:Key="CorCard" Color="#1F1F35"/>
            <SolidColorBrush x:Key="CorBorda" Color="#2D3B4D"/>
            <SolidColorBrush x:Key="CorTexto" Color="#F0F4FF"/>
            <SolidColorBrush x:Key="CorTextoSecundario" Color="#9AA5B8"/>
            <SolidColorBrush x:Key="CorAcento" Color="#00D9FF"/>
            <SolidColorBrush x:Key="CorAcentoHover" Color="#00E8FF"/>
            <SolidColorBrush x:Key="CorErro" Color="#FF5C6C"/>
            <SolidColorBrush x:Key="CorAviso" Color="#FFC857"/>
            <SolidColorBrush x:Key="CorSucesso" Color="#3DDC97"/>

            <FontFamily x:Key="FontePrincipal">Segoe UI Variable Display, Segoe UI, Arial</FontFamily>

            <!-- Texto -->
            <Style x:Key="Titulo" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontePrincipal}"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource CorTexto}"/>
            </Style>
            <Style x:Key="Subtitulo" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontePrincipal}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource CorTextoSecundario}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="Rotulo" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontePrincipal}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource CorTexto}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <!-- Botoes -->
            <Style x:Key="Botao" TargetType="Button">
                <!-- Sem isso, o WPF desenha o retangulo de foco padrao por cima de QUALQUER
                     template customizado. Foi o "contorno estranho" ao redor do botao
                     primario da tela de conclusao (aparece assim que o botao recebe foco,
                     mesmo sem o usuario clicar nele). -->
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="FontFamily" Value="{StaticResource FontePrincipal}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{StaticResource CorTexto}"/>
                <Setter Property="Background" Value="{StaticResource CorCard}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CorBorda}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource Botao}">
                <Setter Property="Background" Value="{StaticResource CorAcento}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CorAcento}"/>
                <Setter Property="Foreground" Value="#0F0F1E"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="BotaoSecundario" TargetType="Button" BasedOn="{StaticResource Botao}">
                <Setter Property="Background" Value="Transparent"/>
            </Style>

            <Style x:Key="BotaoPerigo" TargetType="Button" BasedOn="{StaticResource Botao}">
                <Setter Property="Background" Value="{StaticResource CorErro}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CorErro}"/>
                <Setter Property="Foreground" Value="#0F0F1E"/>
            </Style>

            <!-- Link discreto (ex.: "Ver detalhes"), sem borda/fundo, so texto -->
            <Style x:Key="BotaoLink" TargetType="Button" BasedOn="{StaticResource Botao}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{StaticResource CorTextoSecundario}"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>

            <!-- Campos -->
            <Style x:Key="CampoTexto" TargetType="Control">
                <Setter Property="FontFamily" Value="{StaticResource FontePrincipal}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Background" Value="{StaticResource CorPainel}"/>
                <Setter Property="Foreground" Value="{StaticResource CorTexto}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CorBorda}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource CampoTexto}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="PasswordBox" BasedOn="{StaticResource CampoTexto}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Log ao vivo -->
            <Style x:Key="CampoCodigo" TargetType="TextBox" BasedOn="{StaticResource CampoTexto}">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Background" Value="{StaticResource CorFundo}"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
